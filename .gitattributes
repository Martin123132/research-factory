# Scientific commitments bind raw file bytes. Do not perform implicit line-ending
# conversion on checkout or staging; an intentional rewrite must regenerate every
# affected hash and contract explicitly.
* -text

*.mp4 binary
*.png binary
*.jpg binary
*.jpeg binary
*.woff2 binary
*.gz binary

# Frozen WB-001 corpus payloads are reviewed by manifest hash, not as source
# text. Public result JSON preserves its original signed/hash-bound CRLF bytes.
factory/workbenches/wb001_lossless_compression/data/public/** binary
factory/workbenches/wb001_lossless_compression/results/**/*.json -text whitespace=cr-at-eol
