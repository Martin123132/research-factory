{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Martin123132/research-factory/blob/main/factory/recovery/key-person-recovery-v1.schema.json",
  "title": "Research Factory key-person recovery drill report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recovery_id", "recorded_at", "scope", "operator", "declared_conditions", "offline_release", "recovered_clone", "administration", "boundary", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "recovery_id": {"$ref": "#/$defs/id"},
    "recorded_at": {"$ref": "#/$defs/utc"},
    "scope": {"const": "RECOVERY_DRILL_NOT_SCIENTIFIC_EVIDENCE"},
    "operator": {"$ref": "#/$defs/identity"},
    "declared_conditions": {
      "type": "object", "additionalProperties": false,
      "required": ["founder_present", "operator_independence", "operator_identity_proven", "resilience_04_qualification"],
      "properties": {
        "founder_present": {"const": false},
        "operator_independence": {"const": "SELF_ASSERTED_NOT_PROVEN"},
        "operator_identity_proven": {"const": false},
        "resilience_04_qualification": {"const": false}
      }
    },
    "offline_release": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_sha256", "source_commit", "source_archive_sha256", "history_bundle_sha256"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit": {"$ref": "#/$defs/git_commit"},
        "source_archive_sha256": {"$ref": "#/$defs/sha256"},
        "history_bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "recovered_clone": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "head_commit", "git_fsck_passed", "origin_configured", "working_tree_clean"],
      "properties": {
        "branch": {"const": "recovered-maintainer"},
        "head_commit": {"$ref": "#/$defs/git_commit"},
        "git_fsck_passed": {"const": true},
        "origin_configured": {"const": false},
        "working_tree_clean": {"const": true}
      }
    },
    "administration": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "upstream_write", "hosted_credentials_required", "scientific_authority_changed"],
      "properties": {
        "action": {"const": "RECOVERED_LOCAL_BRANCH_CREATED"},
        "upstream_write": {"const": false},
        "hosted_credentials_required": {"const": false},
        "scientific_authority_changed": {"const": false}
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["scientific_evidence", "promotion_changed", "quality_control_changed", "independent_maintainers_proven", "resilience_04_satisfied"],
      "properties": {
        "scientific_evidence": {"const": false},
        "promotion_changed": {"const": false},
        "quality_control_changed": {"const": false},
        "independent_maintainers_proven": {"const": false},
        "resilience_04_satisfied": {"const": false}
      }
    },
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{2,159}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["operator_id", "display_name", "identity_assurance", "identity_warning"],
      "properties": {
        "operator_id": {"$ref": "#/$defs/id"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "identity_assurance": {"enum": ["SELF_ASSERTED_LOCAL", "PLATFORM_VERIFIED", "EXTERNALLY_ATTESTED"]},
        "identity_warning": {"const": "IDENTITY_RECORD_IS_NOT_PROOF_OF_AUTHORITY"}
      }
    }
  }
}
