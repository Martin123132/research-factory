{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-factory.invalid/schemas/portable-evidence-package-v1.json",
  "title": "Research Factory portable construction or commissioning evidence package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_type",
    "generated_at",
    "operating_mode",
    "evidence_kind",
    "workbench",
    "attempt_id",
    "accountable_human",
    "method",
    "environment",
    "evidence",
    "provenance",
    "construction_boundary",
    "package_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_type": { "const": "RESEARCH_FACTORY_PORTABLE_EVIDENCE" },
    "generated_at": { "type": "string", "format": "date-time" },
    "operating_mode": {
      "enum": ["HANGAR_CONSTRUCTION", "SYNTHETIC_COMMISSIONING"]
    },
    "evidence_kind": {
      "enum": [
        "CONSTRUCTION",
        "CANDIDATE",
        "NEGATIVE_RESULT",
        "REPRODUCTION",
        "DISPUTE",
        "SHIFT_REPORT"
      ]
    },
    "workbench": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "title",
        "contract_sha256",
        "contract_file_sha256",
        "contract_path",
        "contract_schema_sha256",
        "contract_schema_path"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^WB-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 2 },
        "contract_sha256": { "$ref": "#/$defs/sha256" },
        "contract_file_sha256": { "$ref": "#/$defs/sha256" },
        "contract_path": { "const": "contract/contract.json" },
        "contract_schema_sha256": { "$ref": "#/$defs/sha256" },
        "contract_schema_path": { "const": "contract/schema.json" }
      }
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{2,159}$"
    },
    "accountable_human": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "identity_assurance", "identity_warning"],
      "properties": {
        "operator_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{2,159}$"
        },
        "identity_assurance": { "const": "SELF_ASSERTED_LOCAL" },
        "identity_warning": { "const": "NOT_PROOF_OF_DISTINCT_HUMAN" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "exact_commands", "stochastic", "seeds"],
      "properties": {
        "summary": { "type": "string", "minLength": 8, "maxLength": 4000 },
        "exact_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
        },
        "stochastic": { "type": "boolean" },
        "seeds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform"],
      "properties": {
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "version", "executable_sha256"],
          "properties": {
            "implementation": { "type": "string", "minLength": 2 },
            "version": { "type": "string", "minLength": 3 },
            "executable_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "release", "machine"],
          "properties": {
            "system": { "type": "string", "minLength": 1 },
            "release": { "type": "string", "minLength": 1 },
            "machine": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_sha256",
        "manifest_path",
        "files_path",
        "file_count",
        "total_bytes"
      ],
      "properties": {
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_path": { "const": "evidence/manifest.json" },
        "files_path": { "const": "evidence/files" },
        "file_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "total_bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_version", "catalogue_sha256", "station_manifest_sha256"],
      "properties": {
        "engine_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "catalogue_sha256": { "$ref": "#/$defs/sha256" },
        "station_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "construction_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_evidence",
        "counts_as_independent_reproduction",
        "eligible_for_promotion",
        "live_research_authorized"
      ],
      "properties": {
        "scientific_evidence": { "const": false },
        "counts_as_independent_reproduction": { "const": false },
        "eligible_for_promotion": { "const": false },
        "live_research_authorized": { "const": false }
      }
    },
    "package_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "properties": { "stochastic": { "const": true } },
            "required": ["stochastic"]
          }
        }
      },
      "then": {
        "properties": {
          "method": {
            "properties": { "seeds": { "minItems": 1 } }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
