{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-factory.local/schemas/contribution-ledger-v1.schema.json",
  "title": "Research Factory contribution ledger v1",
  "description": "A role and provenance record. It does not decide legal inventorship, publication authorship or external prize entitlement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_version",
    "entries",
    "external_prize_authority",
    "factory_automatic_share",
    "collaboration_agreement",
    "credit_disputes"
  ],
  "properties": {
    "ledger_version": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "roles",
          "contribution",
          "artifact_refs",
          "credit_status",
          "inventorship_review"
        ],
        "properties": {
          "subject_id": { "type": "string", "minLength": 3, "maxLength": 200 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "PROBLEM_FORMULATION",
                "METHODOLOGY",
                "SOFTWARE",
                "FORMALIZATION",
                "INVESTIGATION",
                "DATA_CURATION",
                "ANALYSIS",
                "VALIDATION",
                "DISCREPANCY_DIAGNOSIS",
                "WRITING",
                "VISUALIZATION",
                "SUPERVISION",
                "PROJECT_ADMINISTRATION",
                "FUNDING_ACQUISITION"
              ]
            }
          },
          "contribution": { "type": "string", "minLength": 10, "maxLength": 2000 },
          "artifact_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3, "maxLength": 500 }
          },
          "credit_status": {
            "enum": [
              "CLAIM_CONTRIBUTOR",
              "VALIDATOR_ONLY",
              "ACKNOWLEDGEMENT",
              "INFRASTRUCTURE_ONLY"
            ]
          },
          "inventorship_review": {
            "enum": [
              "NOT_ASSESSED",
              "POSSIBLE_REVIEW_REQUIRED",
              "NO_INVENTORSHIP_CLAIM"
            ]
          }
        }
      }
    },
    "external_prize_authority": { "const": "EXTERNAL_BODY_DECIDES" },
    "factory_automatic_share": { "const": "NONE" },
    "collaboration_agreement": {
      "enum": ["NOT_APPLICABLE", "RECORDED_OUTSIDE_REPOSITORY", "NOT_RECORDED"]
    },
    "credit_disputes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 500 }
    }
  }
}
