{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-factory.local/schemas/wb001-image-lock-v1.json",
  "title": "WB-001 Docker image lock",
  "type": "object",
  "required": [
    "schema_version",
    "lock_type",
    "image_tag",
    "image_id",
    "dockerfile_sha256",
    "requirements_sha256",
    "policy_sha256",
    "promotion_grade",
    "image_lock_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "lock_type": {"const": "wb001_docker_image"},
    "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "promotion_grade": {"type": "boolean"},
    "image_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
