{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WB-001 candidate package v1",
  "type": "object",
  "required": [
    "schema_version",
    "package_type",
    "candidate",
    "recorded_public_evidence",
    "evaluator",
    "sealed_evaluator_handoff",
    "payload",
    "construction_boundary",
    "package_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_type": { "const": "wb001_candidate_package" },
    "generated_at": { "type": "string", "format": "date-time" },
    "workbench": {
      "type": "object",
      "required": ["id", "version"],
      "properties": { "id": { "const": "WB-001" }, "version": { "const": "0.2.0" } },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["submission_id", "candidate_artifact_sha256", "artifact_manifest", "execution_class"],
      "properties": {
        "submission_id": { "type": "string", "minLength": 1 },
        "candidate_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact_manifest": { "type": "object" },
        "execution_class": { "enum": ["REFERENCE_FIXTURE_TRUSTED_LOCAL_ONLY", "UNTRUSTED_CANDIDATE_ISOLATED_EVALUATOR_REQUIRED"] }
      },
      "additionalProperties": false
    },
    "recorded_public_evidence": {
      "type": "object",
      "required": ["result_sha256", "frontier_comparison_sha256", "baseline_pack_sha256", "frontier_status", "public_corpus_sha256", "timing_is_advisory"],
      "properties": {
        "result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "frontier_comparison_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baseline_pack_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "frontier_status": { "type": "string" },
        "public_corpus_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "timing_is_advisory": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evaluator": {
      "type": "object",
      "required": ["software_sha256", "software_lock_path", "production_rerun_command", "local_execution_warning"],
      "properties": {
        "software_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "software_lock_path": { "const": "contracts/evaluator-software.lock.json" },
        "production_rerun_command": { "const": "evaluate_isolated.py" },
        "local_execution_warning": { "const": "DO_NOT_RUN_UNKNOWN_SUBMISSIONS_WITH_EVALUATE_LOCAL" }
      },
      "additionalProperties": false
    },
    "sealed_evaluator_handoff": {
      "type": "object",
      "required": ["path", "handoff_sha256", "state"],
      "properties": {
        "path": { "const": "handoff.json" },
        "handoff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "state": { "const": "BLOCKED_AWAITING_TWO_OTHER_HUMAN_RERUNS" }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": ["files", "payload_sha256", "file_count", "total_bytes"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?!.*(?:^|/)\\.?(?:/|$))(?!.*\\.\\.)[^\\\\]+$" },
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "file_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "total_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      },
      "additionalProperties": false
    },
    "construction_boundary": {
      "type": "object",
      "required": ["operating_mode", "scientific_evidence", "counts_as_independent_reproduction", "eligible_for_promotion", "live_research_authorized"],
      "properties": {
        "operating_mode": { "const": "SYNTHETIC_COMMISSIONING" },
        "scientific_evidence": { "const": false },
        "counts_as_independent_reproduction": { "const": false },
        "eligible_for_promotion": { "const": false },
        "live_research_authorized": { "const": false }
      },
      "additionalProperties": false
    },
    "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
