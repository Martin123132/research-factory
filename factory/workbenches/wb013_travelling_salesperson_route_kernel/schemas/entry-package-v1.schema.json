{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_type", "generated_at", "workbench", "candidate", "entry_fixture", "locked_assets", "sealed_evaluator_handoff", "payload", "construction_boundary", "package_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "package_type": { "const": "wb013_entry_fixture_package" },
    "generated_at": { "type": "string", "format": "date-time" },
    "workbench": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "implementation_version"],
      "properties": { "code": { "const": "WB-013" }, "implementation_version": { "const": "0.1.0" } }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["submission_id", "source_manifest", "source_package_sha256", "execution_class"],
      "properties": {
        "submission_id": { "const": "factory-reference-held-karp-v1" },
        "source_manifest": { "type": "array", "minItems": 1 },
        "source_package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "execution_class": { "const": "REFERENCE_FIXTURE_TRUSTED_LOCAL_ONLY" }
      }
    },
    "entry_fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_sha256", "reference_length", "scope"],
      "properties": {
        "fixture_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reference_length": { "const": 33 },
        "scope": { "const": "ENTRY_GATE_ONLY" }
      }
    },
    "locked_assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "source_path", "package_path", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "pattern": "^factory/" },
          "package_path": { "type": "string", "pattern": "^locked/" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "sealed_evaluator_handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "handoff_sha256", "state"],
      "properties": {
        "path": { "const": "handoff.json" },
        "handoff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "state": { "const": "NOT_ELIGIBLE_ENTRY_ONLY" }
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "payload_sha256", "file_count", "total_bytes"],
      "properties": {
        "files": { "type": "array", "minItems": 1 },
        "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "file_count": { "type": "integer", "minimum": 1, "maximum": 48 },
        "total_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      }
    },
    "construction_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["operating_mode", "scientific_evidence", "counts_as_independent_reproduction", "eligible_for_promotion", "official_tsplib_score", "live_research_authorized"],
      "properties": {
        "operating_mode": { "const": "HANGAR_CONSTRUCTION" },
        "scientific_evidence": { "const": false },
        "counts_as_independent_reproduction": { "const": false },
        "eligible_for_promotion": { "const": false },
        "official_tsplib_score": { "const": false },
        "live_research_authorized": { "const": false }
      }
    },
    "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
