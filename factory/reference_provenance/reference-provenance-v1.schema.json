{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Martin123132/research-factory/blob/main/factory/reference_provenance/reference-provenance-v1.schema.json",
  "title": "Research Factory catalogue reference provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "generated_at_utc",
    "catalogue_path",
    "catalogue_sha256",
    "scope",
    "hash_algorithm",
    "factory_licensing_scope",
    "retrieval_method",
    "dataset_files_committed",
    "candidate_artifacts_committed",
    "stations"
  ],
  "properties": {
    "$schema": {
      "const": "reference-provenance-v1.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^WB[0-9]{3}-WB[0-9]{3}-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generated_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "catalogue_path": {
      "const": "research_factory_100_workbenches.json"
    },
    "catalogue_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "scope": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/workbench_code"
      }
    },
    "hash_algorithm": {
      "const": "SHA-256"
    },
    "factory_licensing_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_factual_fields",
        "upstream_material"
      ],
      "properties": {
        "manifest_factual_fields": {
          "const": "CC0-1.0"
        },
        "upstream_material": {
          "const": "not-relicensed-by-the-research-factory"
        }
      }
    },
    "retrieval_method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "redirect_policy",
        "tls_certificate_verification",
        "hash_scope",
        "user_agent"
      ],
      "properties": {
        "client": {
          "type": "string",
          "minLength": 3
        },
        "redirect_policy": {
          "const": "follow"
        },
        "tls_certificate_verification": {
          "const": "required"
        },
        "hash_scope": {
          "const": "exact response-body bytes emitted by curl after redirects"
        },
        "user_agent": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "dataset_files_committed": {
      "const": false
    },
    "candidate_artifacts_committed": {
      "const": false
    },
    "stations": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/station"
      }
    }
  },
  "$defs": {
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workbench_code": {
      "type": "string",
      "pattern": "^WB-(?:00[1-9]|0[1-9][0-9]|100)$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organisation",
        "basis"
      ],
      "properties": {
        "organisation": {
          "type": "string",
          "minLength": 2
        },
        "basis": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "upstream_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terms_status",
        "terms_url",
        "redistribution_status",
        "factory_license_applies_to_upstream_material",
        "notes"
      ],
      "properties": {
        "terms_status": {
          "enum": [
            "not-stated-on-reference-page",
            "competition-rules",
            "source-specific-conditions",
            "publisher-permission-and-patent-notice"
          ]
        },
        "terms_url": {
          "oneOf": [
            {
              "$ref": "#/$defs/https_url"
            },
            {
              "type": "null"
            }
          ]
        },
        "redistribution_status": {
          "enum": [
            "not-granted-by-reference",
            "conditional-by-upstream-license"
          ]
        },
        "factory_license_applies_to_upstream_material": {
          "const": false
        },
        "notes": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "requested_url",
        "retrieved_at_utc",
        "outcome",
        "curl_exit_code",
        "http_status",
        "final_url",
        "redirect_count",
        "content_type",
        "response_size_bytes",
        "response_sha256",
        "error"
      ],
      "properties": {
        "role": {
          "enum": [
            "catalogue-reference",
            "authoritative-supporting-document",
            "upstream-terms"
          ]
        },
        "requested_url": {
          "$ref": "#/$defs/https_url"
        },
        "retrieved_at_utc": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "outcome": {
          "enum": [
            "retrieved",
            "failed"
          ]
        },
        "curl_exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "http_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 599
        },
        "final_url": {
          "oneOf": [
            {
              "$ref": "#/$defs/https_url"
            },
            {
              "type": "null"
            }
          ]
        },
        "redirect_count": {
          "type": "integer",
          "minimum": 0
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "response_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "response_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workbench_code",
        "catalogue_id",
        "catalogue_title",
        "benchmark_label",
        "catalogue_reference_url",
        "authority",
        "reference_assessment",
        "assessment_notes",
        "retrievals",
        "upstream_terms"
      ],
      "properties": {
        "workbench_code": {
          "$ref": "#/$defs/workbench_code"
        },
        "catalogue_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "catalogue_title": {
          "type": "string",
          "minLength": 5
        },
        "benchmark_label": {
          "type": "string",
          "minLength": 3
        },
        "catalogue_reference_url": {
          "$ref": "#/$defs/https_url"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "reference_assessment": {
          "enum": [
            "available",
            "available-with-ambiguity",
            "retrieval-failed"
          ]
        },
        "assessment_notes": {
          "type": "string",
          "minLength": 20
        },
        "retrievals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/retrieval"
          }
        },
        "upstream_terms": {
          "$ref": "#/$defs/upstream_terms"
        }
      }
    }
  }
}
