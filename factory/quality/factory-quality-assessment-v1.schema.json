{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Martin123132/research-factory/blob/main/factory/quality/factory-quality-assessment-v1.schema.json",
  "title": "Research Factory quality assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "assessment_version",
    "assessment_id",
    "assessed_at_utc",
    "standard_version",
    "standard_path",
    "standard_sha256",
    "subject",
    "scope_boundary",
    "profile",
    "certifications",
    "operating_facts",
    "summary",
    "results"
  ],
  "properties": {
    "$schema": { "const": "factory-quality-assessment-v1.schema.json" },
    "assessment_version": { "const": 1 },
    "assessment_id": {
      "type": "string",
      "pattern": "^RFQ-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$"
    },
    "assessed_at_utc": { "$ref": "#/$defs/timestamp" },
    "standard_version": { "const": "1.0.0" },
    "standard_path": { "const": "factory/quality/factory-quality-standard-v1.json" },
    "standard_sha256": { "$ref": "#/$defs/sha256" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "baseline_revision", "baseline_purpose"],
      "properties": {
        "name": { "const": "Research Factory" },
        "repository": { "const": "https://github.com/Martin123132/research-factory" },
        "baseline_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baseline_purpose": {
          "const": "LAST_MERGED_REVISION_BEFORE_THIS_ASSESSMENT"
        }
      }
    },
    "scope_boundary": {
      "const": "CONSTRUCTION_AND_SYNTHETIC_COMMISSIONING_ONLY"
    },
    "profile": {
      "enum": [
        "FOUNDATION_ONLY",
        "OPERATIONALLY_CONFORMANT",
        "SCIENTIFICALLY_DEMONSTRATED",
        "INDEPENDENTLY_AUDITED"
      ]
    },
    "certifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationally_conformant",
        "scientifically_demonstrated",
        "independently_audited"
      ],
      "properties": {
        "operationally_conformant": { "type": "boolean" },
        "scientifically_demonstrated": { "type": "boolean" },
        "independently_audited": { "type": "boolean" }
      }
    },
    "operating_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogue_stations",
        "live_research_stations",
        "independent_human_validators_onboarded",
        "observed_live_two_person_reproductions",
        "independent_quality_audits"
      ],
      "properties": {
        "catalogue_stations": { "type": "integer", "minimum": 0 },
        "live_research_stations": { "type": "integer", "minimum": 0 },
        "independent_human_validators_onboarded": { "type": "integer", "minimum": 0 },
        "observed_live_two_person_reproductions": { "type": "integer", "minimum": 0 },
        "independent_quality_audits": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controls", "meets", "partial", "blocked"],
      "properties": {
        "controls": { "const": 28 },
        "meets": { "type": "integer", "minimum": 0, "maximum": 28 },
        "partial": { "type": "integer", "minimum": 0, "maximum": 28 },
        "blocked": { "type": "integer", "minimum": 0, "maximum": 28 }
      }
    },
    "results": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_level": {
      "enum": [
        "NONE",
        "DECLARED",
        "ENFORCED",
        "OBSERVED",
        "INDEPENDENTLY_AUDITED"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "supports"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "supports": { "type": "string", "minLength": 10 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "critical",
        "minimum_evidence_level",
        "outcome",
        "evidence_level",
        "evidence",
        "limitation"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{2}$"
        },
        "critical": { "type": "boolean" },
        "minimum_evidence_level": { "$ref": "#/$defs/evidence_level" },
        "outcome": { "enum": ["MEETS", "PARTIAL", "BLOCKED"] },
        "evidence_level": { "$ref": "#/$defs/evidence_level" },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "limitation": {
          "oneOf": [
            { "type": "string", "minLength": 20 },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
