{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Martin123132/research-factory/blob/main/factory/dispatch/container-run-request-v1.schema.json",
  "title": "Research Factory constrained container dispatch request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_type",
    "request_id",
    "budget_sha256",
    "ticket_sha256",
    "image_ref",
    "argv",
    "output_path",
    "request_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_type": { "const": "CONTAINER_DISPATCH_REQUEST" },
    "request_id": { "$ref": "#/$defs/id" },
    "budget_sha256": { "$ref": "#/$defs/sha256" },
    "ticket_sha256": { "$ref": "#/$defs/sha256" },
    "image_ref": {
      "type": "string",
      "minLength": 73,
      "maxLength": 512,
      "pattern": "^.+@sha256:[0-9a-f]{64}$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "output_path": { "$ref": "#/$defs/repository_path" },
    "request_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{2,159}$" },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\r\\n]+$"
    }
  }
}
