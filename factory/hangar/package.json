{
  "name": "research-factory-hangar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/guard-braces.mjs",
    "security:verify": "node scripts/guard-braces.mjs --check",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "predev": "npm run security:verify",
    "dev": "vite dev",
    "prebuild": "npm run security:verify",
    "build": "vite build",
    "start": "vinext start",
    "test": "npm run catalogue:verify && npm run contracts:verify && npm run build && node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run security:verify",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern video",
    "db:generate": "drizzle-kit generate",
    "catalogue:verify": "node scripts/verify-catalogue.mjs",
    "contracts:verify": "node scripts/verify-station-kits.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261011.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.36",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "1.0.1",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "fflate": "0.7.5",
    "sharp": "0.35.5",
    "undici": "7.29.1"
  },
  "type": "module"
}
