{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Factory fixture packet adapter registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registrations", "registry_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workbench_code", "adapter_path", "adapter_file_sha256"],
        "properties": {
          "workbench_code": { "type": "string", "pattern": "^WB-[0-9]{3}$" },
          "adapter_path": {
            "type": "string",
            "pattern": "^factory/fixture_packets/adapters/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.json$"
          },
          "adapter_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "registry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
