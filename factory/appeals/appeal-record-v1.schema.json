{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Martin123132/research-factory/blob/main/factory/appeals/appeal-record-v1.schema.json",
  "title": "Research Factory conflict-independent procedural appeal record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "appeal_id",
    "recorded_at",
    "case",
    "panel",
    "findings",
    "outcome",
    "follow_up",
    "decision_public_summary",
    "boundary",
    "previous_record_sha256",
    "record_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "appeal_id": { "$ref": "#/$defs/id" },
    "recorded_at": { "$ref": "#/$defs/utc_timestamp" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_kind",
        "target",
        "requester",
        "materially_involved_identity_ids",
        "public_summary",
        "evidence_references"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/id" },
        "case_kind": {
          "enum": ["SCIENTIFIC_DISPUTE", "RIGHTS_AND_CREDIT", "SAFETY", "GOVERNANCE"]
        },
        "target": { "$ref": "#/$defs/artifact_reference" },
        "requester": { "$ref": "#/$defs/identity" },
        "materially_involved_identity_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "public_summary": { "$ref": "#/$defs/summary" },
        "evidence_references": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/artifact_reference" }
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_method",
        "minimum_reviewer_count",
        "reviewer_identity_warning",
        "reviewers"
      ],
      "properties": {
        "selection_method": { "const": "CONFLICT_EXCLUSION_CHECK_V1" },
        "minimum_reviewer_count": { "const": 2 },
        "reviewer_identity_warning": {
          "const": "IDENTITY_RECORD_IS_NOT_PROOF_OF_A_DISTINCT_HUMAN"
        },
        "reviewers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operator_id",
              "display_name",
              "identity_assurance",
              "identity_warning",
              "conflict_declaration",
              "conflict_evidence_sha256"
            ],
            "properties": {
              "operator_id": { "$ref": "#/$defs/id" },
              "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
              "identity_assurance": {
                "enum": ["SELF_ASSERTED_LOCAL", "PLATFORM_VERIFIED", "EXTERNALLY_ATTESTED"]
              },
              "identity_warning": {
                "const": "IDENTITY_RECORD_IS_NOT_PROOF_OF_A_DISTINCT_HUMAN"
              },
              "conflict_declaration": { "const": "NO_MATERIAL_CONFLICT_DECLARED" },
              "conflict_evidence_sha256": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "conclusion", "evidence_sha256", "public_summary"],
        "properties": {
          "reviewer_id": { "$ref": "#/$defs/id" },
          "conclusion": {
            "enum": ["UPHOLD_APPEAL", "DENY_APPEAL", "RETURN_TO_DIAGNOSIS"]
          },
          "evidence_sha256": { "$ref": "#/$defs/sha256" },
          "public_summary": { "$ref": "#/$defs/summary" }
        }
      }
    },
    "outcome": {
      "enum": ["UPHOLD_PROCEDURALLY", "DENY_PROCEDURALLY", "RETURN_FOR_DIAGNOSIS"]
    },
    "follow_up": {
      "enum": [
        "SEPARATE_CORRECTION_OR_REMEDY_RECORD_REQUIRED",
        "NO_AUTOMATIC_STANDING_CHANGE",
        "FRESH_DIAGNOSTIC_RUN_REQUIRED"
      ]
    },
    "decision_public_summary": { "$ref": "#/$defs/summary" },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "append_only",
        "material_conflict_exclusion_enforced",
        "automatic_scientific_standing_change",
        "scientific_evidence",
        "counts_as_independent_reproduction",
        "eligible_for_promotion"
      ],
      "properties": {
        "scope": { "const": "PUBLIC_PROCEDURAL_APPEAL_ONLY" },
        "append_only": { "const": true },
        "material_conflict_exclusion_enforced": { "const": true },
        "automatic_scientific_standing_change": { "const": false },
        "scientific_evidence": { "const": false },
        "counts_as_independent_reproduction": { "const": false },
        "eligible_for_promotion": { "const": false }
      }
    },
    "previous_record_sha256": { "$ref": "#/$defs/sha256" },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "UPHOLD_PROCEDURALLY" } }, "required": ["outcome"] },
      "then": { "properties": { "follow_up": { "const": "SEPARATE_CORRECTION_OR_REMEDY_RECORD_REQUIRED" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "DENY_PROCEDURALLY" } }, "required": ["outcome"] },
      "then": { "properties": { "follow_up": { "const": "NO_AUTOMATIC_STANDING_CHANGE" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "RETURN_FOR_DIAGNOSIS" } }, "required": ["outcome"] },
      "then": { "properties": { "follow_up": { "const": "FRESH_DIAGNOSTIC_RUN_REQUIRED" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{2,159}$" },
    "utc_timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$" },
    "summary": { "type": "string", "minLength": 8, "maxLength": 2000 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "display_name", "identity_assurance", "identity_warning"],
      "properties": {
        "operator_id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "identity_assurance": {
          "enum": ["SELF_ASSERTED_LOCAL", "PLATFORM_VERIFIED", "EXTERNALLY_ATTESTED"]
        },
        "identity_warning": { "const": "IDENTITY_RECORD_IS_NOT_PROOF_OF_A_DISTINCT_HUMAN" }
      }
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class", "artifact_id", "artifact_sha256", "locator_kind", "locator", "media_type", "visibility"
      ],
      "properties": {
        "artifact_class": {
          "enum": [
            "CONTROL_PLANE_EVENT", "SHIFT_REPORT", "PORTABLE_EVIDENCE_PACKAGE", "STATION_CONTRACT",
            "CONTRIBUTION_LEDGER", "RIGHTS_AND_IP_RECORD", "QUALITY_ASSESSMENT", "CORRECTION_RECORD",
            "APPEAL_RECORD", "PUBLIC_ARTIFACT"
          ]
        },
        "artifact_id": { "$ref": "#/$defs/id" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "locator_kind": { "enum": ["REPOSITORY_PATH", "PUBLIC_URL"] },
        "locator": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[A-Za-z0-9.+-]+$", "maxLength": 100 },
        "visibility": { "const": "PUBLIC" }
      }
    }
  }
}
