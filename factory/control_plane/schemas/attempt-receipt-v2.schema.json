{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-factory.invalid/schemas/attempt-receipt-v2.json",
  "title": "Research Factory monitored attempt receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "attempt_id",
    "envelope_id",
    "envelope_sha256",
    "operator_id",
    "started_at",
    "finished_at",
    "command_sha256",
    "working_directory",
    "exit_code",
    "termination_reason",
    "wall_seconds",
    "output_bytes",
    "stdout_sha256",
    "stderr_sha256",
    "cost_minor_units",
    "currency",
    "network_enforcement",
    "within_envelope",
    "promotion_eligible",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "receipt_type": {"const": "MONITORED_ATTEMPT_EXECUTION"},
    "attempt_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "envelope_id": {"type": "string", "pattern": "^envelope:[0-9a-f]{32}$"},
    "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "working_directory": {"type": "string", "minLength": 1, "maxLength": 512},
    "exit_code": {"type": ["integer", "null"]},
    "termination_reason": {
      "enum": ["COMPLETED", "HUMAN_STOP", "WALL_TIME_LIMIT", "OUTPUT_LIMIT", "LAUNCH_ERROR", "PROCESS_ERROR"]
    },
    "wall_seconds": {"type": "number", "minimum": 0},
    "output_bytes": {"type": "integer", "minimum": 0},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cost_minor_units": {"const": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "network_enforcement": {"const": "NOT_VERIFIED_LOCAL_PROFILE"},
    "within_envelope": {"type": "boolean"},
    "promotion_eligible": {"const": false},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
