{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-factory.invalid/schemas/work-order-envelope-v2.json",
  "title": "Issued Research Factory Work Order Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_type",
    "envelope_id",
    "policy_sha256",
    "factory_id",
    "round_id",
    "round_sha256",
    "work_unit_id",
    "work_claim_id",
    "operator_id",
    "issued_by",
    "issued_at",
    "expires_at",
    "release_capability_sha256",
    "scope",
    "enforcement_profile",
    "allowed_command",
    "working_directory",
    "allowed_interfaces",
    "network_policy",
    "resource_limits",
    "stop_conditions",
    "extension_policy",
    "promotion_eligible",
    "envelope_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "envelope_type": {"const": "WORK_ORDER_ENVELOPE"},
    "envelope_id": {"type": "string", "pattern": "^envelope:[0-9a-f]{32}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "factory_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "round_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "round_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "work_unit_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "work_claim_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "operator_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "issued_by": {"type": "string", "minLength": 3, "maxLength": 160},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "release_capability_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"enum": ["SYNTHETIC_COMMISSIONING", "LOCAL_RESEARCH"]},
    "enforcement_profile": {"const": "LOCAL_MONITORED_V1"},
    "allowed_command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "working_directory": {"type": "string", "minLength": 1, "maxLength": 512},
    "allowed_interfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["LOCAL_SUBPROCESS", "STDIN", "STDOUT", "STDERR", "DECLARED_INPUT_FILES"]}
    },
    "network_policy": {"const": "NOT_GRANTED_UNVERIFIED_BY_LOCAL_PROFILE"},
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_seconds", "max_output_bytes", "max_cost_minor_units", "currency"],
      "properties": {
        "max_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 14400},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "max_cost_minor_units": {"const": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "extension_policy": {"const": "NEW_CLAIM_AND_ENVELOPE_ONLY"},
    "promotion_eligible": {"const": false},
    "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
