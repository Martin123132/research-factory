{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-factory.invalid/schemas/work-order-envelope-policy-v2.json",
  "title": "Research Factory Work Order Envelope policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_type",
    "policy_id",
    "scope",
    "enforcement_profile",
    "allowed_command",
    "working_directory",
    "allowed_interfaces",
    "network_policy",
    "resource_limits",
    "stop_conditions",
    "extension_policy",
    "promotion_eligible",
    "policy_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "policy_type": {"const": "WORK_ORDER_ENVELOPE_POLICY"},
    "policy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{2,159}$"},
    "scope": {"enum": ["SYNTHETIC_COMMISSIONING", "LOCAL_RESEARCH"]},
    "enforcement_profile": {"const": "LOCAL_MONITORED_V1"},
    "allowed_command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "working_directory": {"type": "string", "minLength": 1, "maxLength": 512},
    "allowed_interfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["LOCAL_SUBPROCESS", "STDIN", "STDOUT", "STDERR", "DECLARED_INPUT_FILES"]}
    },
    "network_policy": {"const": "NOT_GRANTED_UNVERIFIED_BY_LOCAL_PROFILE"},
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_seconds", "max_output_bytes", "max_cost_minor_units", "currency"],
      "properties": {
        "max_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 14400},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "max_cost_minor_units": {"const": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "HUMAN_STOP_REQUESTED",
          "WALL_TIME_LIMIT_REACHED",
          "OUTPUT_LIMIT_REACHED",
          "PROCESS_EXITED",
          "PROCESS_LAUNCH_FAILED"
        ]
      }
    },
    "extension_policy": {"const": "NEW_CLAIM_AND_ENVELOPE_ONLY"},
    "promotion_eligible": {"const": false},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
